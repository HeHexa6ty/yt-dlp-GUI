{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-ytdlp-gui",
  "version": "0.1.0",
  "identifier": "com.catchy.tauri-ytdlp-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-ytdlp-gui",
        "width": 600,
        "height": 750,
        "minWidth": 500,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/yt-dlp-sidecar",
      "binaries/ffmpeg-sidecar",
      "binaries/ffprobe-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true

  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBRDcyMzc1MjhERTUxNjYKUldSbVVkNG9kU1BYNmxzTkIxa3Y1S01SS0xVNk1hS0gxcTRBanh5QmFWT01CZmt2U3E4Qmhkc1oK",
      "endpoints": [
        "https://github.com/HeHexa6ty/yt-dlp-GUI/releases/latest/download/latest.json"
      ]
    }
  }
}