{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-ytdlp-gui",
  "version": "0.1.0",
  "identifier": "com.catchy.tauri-ytdlp-gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tauri-ytdlp-gui",
        "width": 600,
        "height": 750,
        "minWidth": 500,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/yt-dlp-sidecar",
      "binaries/ffmpeg-sidecar",
      "binaries/ffprobe-sidecar"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxOTVCREY3Q0VCRkMxMzcKUldRM3diL085NzJWWVc3cjN4TlJRTDRpeGlubGVMLzBGVEFiNHhpM2orbXdCM2Y5TXpySU5mNngK"
    }
  }
}